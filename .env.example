# Project Goblin — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─────────────────────────────────────────────
# AI Brain
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID
# Send a message to @userinfobot to find it
TELEGRAM_CHAT_ID=your_chat_id_here

# ─────────────────────────────────────────────
# Jellyfin / Docker
# ─────────────────────────────────────────────
# The exact name of your Jellyfin container (check: docker ps)
JELLYFIN_CONTAINER_NAME=jellyfin

# Path to Docker socket (default works on Linux/Mac)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ─────────────────────────────────────────────
# Agent Behaviour
# ─────────────────────────────────────────────
# How often to poll for health data (seconds)
POLL_INTERVAL_SECONDS=60

# Logging verbosity: DEBUG or INFO
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# Thresholds (optional overrides)
# ─────────────────────────────────────────────
# Alert if CPU usage exceeds this % (default: 90)
CPU_ALERT_THRESHOLD=90

# Alert if RAM usage exceeds this % (default: 85)
RAM_ALERT_THRESHOLD=85

# Alert if disk usage exceeds this % (default: 90)
DISK_ALERT_THRESHOLD=90
